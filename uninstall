#!/bin/bash
set -e -o pipefail

# uninstall
# =========
# Removes Shepherd-Traefik from a Linux box. Takes no arguments and reads no env
# variables.
#
# USAGE
# -----
#   sudo /opt/shepherd-traefik/uninstall
#
# Prompts twice for ENTER: once before killing containers, once before restarting
# the docker daemon.
#
# WARNING: NOT SHEPHERD-SCOPED
# ----------------------------
# It stops and removes ALL docker containers on the box and runs
# `docker system prune -a -f`, not just Shepherd's. Do not run it on a box that
# hosts anything else.
#
# WHAT SURVIVES
# -------------
# /etc/shepherd is kept on purpose, so that a reinstall lands on the existing
# shepherd-java config instead of the scaffolded default. Everything else goes:
# /etc/docker/daemon.json (so the enlarged address pools and the containerd
# snapshotter revert), /var/cache/shepherd, /var/opt/shepherd (Jenkins home AND
# the Traefik TLS certificates - a reinstall re-issues them from Let's Encrypt),
# and the weekly cache-purge cron symlink.

read -p "Warning: this will stop and kill all running Docker containers, including non-Shepherd ones. Press ENTER to proceed."

# stop and kill all docker containers
if [[ -n "$(docker ps -a -q)" ]]; then
  docker stop $(docker ps -a -q)
  docker rm $(docker ps -a -q)
fi

# nuke everything docker-related
docker system prune -a -f
docker system df

# Remove the custom Docker configuration
rm -rf /etc/docker/daemon.json

read -p "Docker daemon will be restarted. Press ENTER to continue."
# Restart the docker daemon, in order for the settings to take effect:
systemctl restart docker.service

# Remove the shepherd docker cache
rm -rf /var/cache/shepherd

# Remove the folder where Jenkins will store everything: projects being built, its configuration,
# its plugins...
rm -rf /var/opt/shepherd

# Remove the weekly cache-purge cron job installed by `install`.
rm -rf /etc/cron.weekly/shepherd-clearcache

# keep /etc/shepherd configuration - see WHAT SURVIVES above.

# done
echo "Shepherd-Traefik is now uninstalled"
